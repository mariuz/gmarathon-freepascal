object frmServerDashboard: TfrmServerDashboard
  Left = 250
  Height = 520
  Top = 140
  Width = 800
  Caption = 'Server Dashboard'
  ClientHeight = 520
  ClientWidth = 800
  OnClose = FormClose
  LCLVersion = '2.2.6.0'
  object pnlTop: TPanel
    Left = 0
    Height = 40
    Top = 0
    Width = 800
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 40
    ClientWidth = 800
    TabOrder = 0
    object lblConnection: TLabel
      Left = 8
      Height = 15
      Top = 12
      Width = 76
      Caption = 'Connection:'
      ParentColor = False
    end
    object lblInterval: TLabel
      Left = 300
      Height = 15
      Top = 12
      Width = 48
      Caption = 'Every:'
      ParentColor = False
    end
    object cmbInterval: TComboBox
      Left = 352
      Height = 23
      Top = 8
      Width = 120
      ItemHeight = 15
      ItemIndex = 1
      Items.Strings = (
        '1 second'
        '5 seconds'
        '15 seconds'
        '1 minute'
      )
      OnChange = cmbIntervalChange
      Style = csDropDownList
      TabOrder = 0
      Text = '5 seconds'
    end
    object btnStart: TButton
      Left = 488
      Height = 25
      Top = 7
      Width = 80
      Caption = 'Start'
      OnClick = btnStartClick
      TabOrder = 1
    end
    object btnStop: TButton
      Left = 576
      Height = 25
      Top = 7
      Width = 80
      Caption = 'Stop'
      Enabled = False
      OnClick = btnStopClick
      TabOrder = 2
    end
    object btnSampleNow: TButton
      Left = 664
      Height = 25
      Top = 7
      Width = 120
      Anchors = [akTop, akRight]
      Caption = 'Sample Now'
      OnClick = btnSampleNowClick
      TabOrder = 3
    end
  end
  object chtRates: TChart
    Left = 0
    Height = 280
    Top = 40
    Width = 800
    AxisList = <
      item
        Grid.Color = clSilver
        Minors = <>
        Title.LabelFont.Orientation = 900
        Title.Visible = True
        Title.Caption = 'Per second'
      end
      item
        Alignment = calBottom
        Grid.Color = clSilver
        Minors = <>
        Title.Visible = True
        Title.Caption = 'Sample'
      end>
    Foot.Brush.Color = clBtnFace
    Foot.Font.Color = clBlue
    Legend.Visible = True
    Title.Brush.Color = clBtnFace
    Title.Font.Color = clBlue
    Title.Text.Strings = (
      'Database activity'
    )
    Title.Visible = True
    Align = alTop
    ParentColor = False
  end
  object splDashboard: TSplitter
    Cursor = crVSplit
    Left = 0
    Height = 5
    Top = 320
    Width = 800
    Align = alTop
    ResizeAnchor = akTop
  end
  object grdRates: TStringGrid
    Left = 0
    Height = 172
    Top = 325
    Width = 800
