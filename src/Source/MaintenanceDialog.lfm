      object btnRestore: TButton
        Left = 8
        Top = 108
        Width = 100
        Height = 25
        Caption = 'R&estore'
        TabOrder = 4
        OnClick = btnRestoreClick
      end
    end
  end
  object pnlLog: TPanel
    Left = 0
    Top = 370
    Width = 692
    Height = 152
    Align = alBottom
    BevelOuter = bvNone
    TabOrder = 2
    object lblLog: TLabel
      Left = 8
      Top = 4
      Width = 21
      Height = 13
      Caption = 'Log:'
    end
    object mmoLog: TMemo
      Left = 8
      Top = 20
      Width = 676
      Height = 128
      Anchors = [akLeft, akTop, akRight, akBottom]
      ReadOnly = True
      ScrollBars = ssVertical
      TabOrder = 0
    end
  end
  object dlgSaveBackup: TSaveDialog
    DefaultExt = '*.fbk'
    Filter = 'Firebird Backup Files (*.fbk)|*.fbk|All Files (*.*)|*.*'
    Options = [ofOverwritePrompt, ofHideReadOnly]
    Title = 'Backup To File'
    Left = 40
    Top = 400
  end
  object dlgOpenRestoreSource: TOpenDialog
    DefaultExt = '*.fbk'
    Filter = 'Firebird Backup Files (*.fbk)|*.fbk|All Files (*.*)|*.*'
    Options = [ofFileMustExist, ofHideReadOnly]
    Title = 'Restore From File'
    Left = 80
    Top = 400
  end
  object dlgSaveRestoreTarget: TSaveDialog
    DefaultExt = '*.fdb'
    Filter = 'Firebird Database Files (*.fdb)|*.fdb|All Files (*.*)|*.*'
    Options = [ofHideReadOnly]
    Title = 'New Database File'
    Left = 120
    Top = 400
  end
  object svcConn: TIBXServicesConnection
    LoginPrompt = False
    Left = 40
    Top = 440
  end
  object svcValidate: TIBXValidationService
    ServicesConnection = svcConn
    OnGetNextLine = ServiceGetNextLine
    Left = 80
    Top = 440
  end
  object svcBackup: TIBXClientSideBackupService
    ServicesConnection = svcConn
    OnGetNextLine = ServiceGetNextLine
    Left = 120
    Top = 440
  end
  object svcRestore: TIBXClientSideRestoreService
    ServicesConnection = svcConn
    OnGetNextLine = ServiceGetNextLine
    Left = 160
    Top = 440
  end
end
