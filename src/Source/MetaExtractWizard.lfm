    object tsOptions: TTabSheet
      Caption = 'Options'
      object rdoExtractType: TRadioGroup
        Left = 8
        Top = 8
        Width = 300
        Height = 90
        Caption = 'Extract'
        ItemIndex = 0
        Items.Strings = (
          'Metadata Only'
          'Metadata and Data'
          'Data Only')
        TabOrder = 0
      end
      object chkCreateDatabase: TCheckBox
        Left = 8
        Top = 106
        Width = 280
        Height = 17
        Caption = 'Include CREATE DATABASE statement'
        TabOrder = 1
      end
      object chkIncludePassword: TCheckBox
        Left = 8
        Top = 128
        Width = 280
        Height = 17
        Caption = 'Include password in CREATE/CONNECT'
