  object dlgSaveScript: TSaveDialog
    DefaultExt = '*.sql'
    Filter = 'SQL Script Files (*.sql)|*.sql|All Files (*.*)|*.*'
    Options = [ofOverwritePrompt, ofHideReadOnly]
