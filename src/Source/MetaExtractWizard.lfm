      end
      object udDecimalPlaces: TUpDown
        Left = 157
        Top = 226
        Width = 15
        Height = 21
        Associate = edDecimalPlaces
        Min = 0
        Max = 15
        Position = 2
        TabOrder = 9
      end
      object lblDecimalSeparator: TLabel
        Left = 8
        Top = 258
