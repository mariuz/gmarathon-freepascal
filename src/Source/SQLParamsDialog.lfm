object frmSQLParams: TfrmSQLParams
  Left = 250
  Top = 180
  Width = 500
  Height = 320
  BorderStyle = bsDialog
  Caption = 'Statement Parameters'
  Color = clBtnFace
  Font.Charset = DEFAULT_CHARSET
  Font.Color = clWindowText
  Font.Height = -11
  Font.Name = 'MS Sans Serif'
  Font.Style = []
  Position = poScreenCenter
  OnCreate = FormCreate
  PixelsPerInch = 96
  TextHeight = 13
  object lblPrompt: TLabel
    Left = 8
    Top = 8
    Width = 400
    Height = 26
    Caption =
      'This statement has parameters. Enter a value for each, or tick NU' +
      'LL.'
    WordWrap = True
  end
  object grdParams: TStringGrid
    Left = 8
    Top = 40
    Width = 476
    Height = 205
    Anchors = [akTop, akLeft, akRight, akBottom]
    ColCount = 4
    FixedCols = 1
    RowCount = 1
    TabOrder = 0
  end
  object btnOK: TButton
    Left = 320
    Top = 254
    Width = 75
    Height = 25
    Anchors = [akRight, akBottom]
    Caption = 'OK'
    Default = True
    ModalResult = 1
    TabOrder = 1
  end
  object btnCancel: TButton
    Left = 404
    Top = 254
    Width = 75
    Height = 25
    Anchors = [akRight, akBottom]
    Cancel = True
    Caption = 'Cancel'
    ModalResult = 2
    TabOrder = 2
  end
end
