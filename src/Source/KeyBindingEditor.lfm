object frmKeyBindings: TfrmKeyBindings
  Left = 260
  Height = 520
  Top = 130
  Width = 620
  BorderStyle = bsSizeable
  Caption = 'Keyboard Shortcuts'
  ClientHeight = 520
  ClientWidth = 620
  Position = poScreenCenter
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  LCLVersion = '2.2.6.0'
  object pnlTop: TPanel
    Left = 0
    Height = 38
    Top = 0
    Width = 620
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 38
    ClientWidth = 620
    TabOrder = 0
    object lblFilter: TLabel
      Left = 8
      Height = 15
      Top = 12
      Width = 32
      Caption = 'Find:'
      ParentColor = False
    end
    object edFilter: TEdit
      Left = 48
      Height = 23
      Top = 8
      Width = 560
      Anchors = [akTop, akLeft, akRight]
      TabOrder = 0
      OnChange = edFilterChange
    end
  end
  object grdKeys: TStringGrid
    Left = 0
    Height = 300
    Top = 38
    Width = 620
    Align = alClient
    ColCount = 3
    Columns = <
      item
        ReadOnly = True
        Title.Caption = 'Command'
        Width = 280
      end
      item
        ReadOnly = True
        Title.Caption = 'Category'
        Width = 140
      end
      item
        ReadOnly = True
        Title.Caption = 'Shortcut'
        Width = 170
      end>
    FixedCols = 0
    Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goRangeSelect, goRowSelect, goSmoothScroll]
    RowCount = 1
    TabOrder = 1
    OnSelection = grdKeysSelection
  end
  object pnlEdit: TPanel
    Left = 0
    Height = 141
    Top = 338
    Width = 620
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 141
    ClientWidth = 620
    TabOrder = 2
    object lblCommand: TLabel
      Left = 8
      Height = 15
      Top = 10
      Width = 4
      Caption = ''
      Font.Style = [fsBold]
      ParentColor = False
      ParentFont = False
    end
    object lblPress: TLabel
      Left = 8
      Height = 15
      Top = 40
      Width = 200
      Caption = 'Press the keys you want to use:'
      ParentColor = False
    end
    object edCapture: TEdit
      Left = 8
      Height = 23
      Top = 62
      Width = 320
      TabOrder = 0
      OnKeyDown = edCaptureKeyDown
    end
    object btnClear: TButton
      Left = 340
      Height = 25
      Top = 61
      Width = 100
      Caption = 'No Shortcut'
      TabOrder = 1
      OnClick = btnClearClick
    end
    object lblConflict: TLabel
      Left = 8
      Height = 15
      Top = 100
      Width = 4
      Caption = ''
      Font.Color = clMaroon
      ParentColor = False
      ParentFont = False
    end
  end
  object pnlButtons: TPanel
    Left = 0
    Height = 41
    Top = 479
    Width = 620
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 41
    ClientWidth = 620
    TabOrder = 3
    object btnReset: TButton
      Left = 8
      Height = 25
      Top = 8
      Width = 130
      Caption = 'Reset All'
      TabOrder = 0
      OnClick = btnResetClick
    end
    object btnOK: TButton
      Left = 432
      Height = 25
      Top = 8
      Width = 85
      Anchors = [akTop, akRight]
      Caption = 'OK'
      Default = True
      ModalResult = 1
      TabOrder = 1
    end
    object btnCancel: TButton
      Left = 525
      Height = 25
      Top = 8
      Width = 85
      Anchors = [akTop, akRight]
      Cancel = True
      Caption = 'Cancel'
      ModalResult = 2
      TabOrder = 2
    end
  end
end
